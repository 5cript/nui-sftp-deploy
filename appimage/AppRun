#!/bin/bash
HERE="$(dirname "$(readlink -f "${0}")")"

# Snapshot of the host environment. Everything below changes it for nui-sftp
# itself, and recordHostEnvironment tells nui-sftp how to undo that for the
# host programs it starts (local terminals, file managers).
declare -A hostEnvironment
for name in $(compgen -e); do
    hostEnvironment["${name}"]="${!name}"
done
# Set by the AppImage runtime before AppRun starts.
appImageRuntimeVariables=(APPDIR APPIMAGE ARGV0 OWD)

recordHostEnvironment() {
    local name
    for name in $(compgen -e); do
        case "${name}" in NUI_SFTP_APPIMAGE_*) continue ;; esac
        if [ -z "${hostEnvironment[${name}]+set}" ]; then
            export "NUI_SFTP_APPIMAGE_UNSET_${name}=1"
        elif [ "${hostEnvironment[${name}]}" != "${!name}" ]; then
            export "NUI_SFTP_APPIMAGE_ORIGINAL_${name}=${hostEnvironment[${name}]}"
        fi
    done
    for name in "${!hostEnvironment[@]}"; do
        if [ -z "${!name+set}" ]; then
            export "NUI_SFTP_APPIMAGE_ORIGINAL_${name}=${hostEnvironment[${name}]}"
        fi
    done
    for name in "${appImageRuntimeVariables[@]}"; do
        unset "NUI_SFTP_APPIMAGE_ORIGINAL_${name}"
        export "NUI_SFTP_APPIMAGE_UNSET_${name}=1"
    done
}
export APPDIR="${HERE}"
export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
# Prepends a bundled compat lib dir to LD_LIBRARY_PATH when the host's copy
# of the library exports an older highest symbol version than the bundled one.
# Using the bundled copy on a newer host would break host libs (e.g. GL
# drivers) that need the newer symbols.
useBundledIfNewer() {
    local soname="$1" versionPrefix="$2" bundledDir="$3"
    local hostLib bundledVersion hostVersion
    hostLib=$(/sbin/ldconfig -p 2>/dev/null | grep -F "${soname} (libc6,x86-64)" | head -n1 | sed 's/.*=> //')
    bundledVersion=$(grep -aoE "${versionPrefix}[0-9.]+" "${bundledDir}/${soname}" | sort -uV | tail -n1)
    if [ -n "${hostLib}" ] && [ -f "${hostLib}" ]; then
        hostVersion=$(grep -aoE "${versionPrefix}[0-9.]+" "${hostLib}" | sort -uV | tail -n1)
        if [ "$(printf '%s\n%s\n' "${hostVersion}" "${bundledVersion}" | sort -V | tail -n1)" = "${hostVersion}" ]; then
            return
        fi
    fi
    export LD_LIBRARY_PATH="${bundledDir}:${LD_LIBRARY_PATH}"
}
useBundledIfNewer libstdc++.so.6 GLIBCXX_ "${HERE}/usr/optional/libstdc++"
useBundledIfNewer libgcc_s.so.1 GCC_ "${HERE}/usr/optional/libgcc_s"

export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# WebKitGTK release builds have no env override for the helper exec path, intercept
# posix_spawn/execve via LD_PRELOAD so spawning WebKitNetworkProcess et al.
# resolves to the bundled copy. The shim reads $APPDIR (set above).
export LD_PRELOAD="${HERE}/usr/lib/appimage-shims/webkit_path_shim.so${LD_PRELOAD:+:${LD_PRELOAD}}"

# Disable the bwrap sandbox (it requires host paths the AppImage can't expose)
# and the dmabuf renderer (relies on the host's exact mesa+kernel combo).
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1

if [ -d "${HERE}/apprun-hooks" ]; then
    for hook in "${HERE}/apprun-hooks/"*.sh; do
        [ -f "${hook}" ] && source "${hook}"
    done
fi

recordHostEnvironment

exec "${HERE}/opt/nui-sftp/bin/nui-sftp" "$@"
